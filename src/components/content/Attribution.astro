---
interface Props {
	sourceUrl: string;
	updated?: string | Date;
}

const { sourceUrl, updated } = Astro.props;

/** The schema allows a plain string or a YAML-parsed Date; either way the
 * page should show the date as written in the frontmatter, not a raw ISO
 * timestamp (or a Date object's default locale rendering). */
const updatedText = updated
	? updated instanceof Date
		? updated.toISOString().slice(0, 10)
		: String(updated).slice(0, 10)
	: undefined;

const isBn = (Astro.locals.starlightRoute?.lang ?? 'en').startsWith('bn');
const issueUrl = 'https://github.com/hasnat-shohag/nodejs-learning-track/issues';
---

<aside class="attribution">
	{
		isBn ? (
			<p>
				এই লেসনটি Node.js-এর{' '}
				<a href={sourceUrl} rel="noopener noreferrer" target="_blank">
					অফিসিয়াল ডকুমেন্টেশনের
				</a>{' '}
				ওপর ভিত্তি করে লেখা। মূল ডকুমেন্টেশন OpenJS Foundation-এর, কৃতিত্ব তাদের।
			</p>
		) : (
			<p>
				This lesson is based on the{' '}
				<a href={sourceUrl} rel="noopener noreferrer" target="_blank">
					official Node.js documentation
				</a>
				. The original docs belong to the OpenJS Foundation.
			</p>
		)
	}
	{
		isBn ? (
			<p>
				ভুল পেলে{' '}
				<a href={issueUrl} rel="noopener noreferrer" target="_blank">
					issue খুলুন
				</a>
				।
			</p>
		) : (
			<p>
				Found a mistake?{' '}
				<a href={issueUrl} rel="noopener noreferrer" target="_blank">
					Open an issue
				</a>
				.
			</p>
		)
	}
	{
		updatedText && (
			<p>
				{isBn ? 'সর্বশেষ হালনাগাদ' : 'Last updated'}: {updatedText}
			</p>
		)
	}
</aside>
